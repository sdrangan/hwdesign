# What hist_build.py produces.  Everything here is regenerated by the next build; none of it
# is edited by hand -- including include/, which gen_include generates (hist_schema.py, and
# Waveflow's adaptor headers).
/include/
/results/
__pycache__/

# One set per version (--top stream, --top mm): the Vitis projects and the XSI workspace.
/proj_*/
/csim_proj_*/
/xsi_*/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the demo there.
/hls_component/
/_ide/
.vitisWorkspace.json

# waveflow's record of each build step run.
/.waveflow/
