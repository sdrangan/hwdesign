# What quad_build.py produces.  Everything here is regenerated by the next
# build; none of it is edited by hand.  The figures the docs show are copied
# to docs/demos/timing/images/.
/data/
/results/
/vcd/
__pycache__/

# What Vitis produces when run.tcl runs.
/quad_proj/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the demo there.
/hls_component/
/_ide/
.vitisWorkspace.json

# waveflow's record of each build step run.
/.waveflow/

# The in-class exercise: the student's own kernel, and everything --fast builds.
/quad_fast.cpp
/fast/
