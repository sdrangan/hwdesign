# What poly_build.py produces.  Everything here is regenerated by the next
# build; none of it is edited by hand.  The figures the docs show are copied
# to docs/demos/loopopt/images/.
/data/
/results/
/vcd/
__pycache__/

# What Vitis produces when run.tcl runs: one project per variant.
/proj_*/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the demo there.
/hls_component/
/_ide/
.vitisWorkspace.json

# waveflow's record of each build step run.
/.waveflow/
