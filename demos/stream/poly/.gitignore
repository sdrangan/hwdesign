# What poly_build.py produces.  Everything here is regenerated by the next
# build; none of it is edited by hand -- including include/, which the
# gen_include step generates from poly_schema.py.
/include/
/vectors/
/results/
/vcd/
__pycache__/

# What Vitis produces when run.tcl runs.
/poly_proj/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the demo there.
/hls_component/
/_ide/
.vitisWorkspace.json
