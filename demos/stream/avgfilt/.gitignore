# What avgfilt_build.py produces.  Everything here is regenerated by the
# next build; none of it is edited by hand.
/vectors/
/results/
/vcd/
__pycache__/

# What Vitis produces when run.tcl runs.
/avgfilt_proj/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the demo there.
/hls_component/
/_ide/
.vitisWorkspace.json
