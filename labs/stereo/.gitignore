# What stereo_build.py produces.  Everything here is regenerated by the next
# build; none of it is edited by hand.
/vectors/
/results/
/eval/
/submission/
/vcd/
__pycache__/

# What Vitis produces when run.tcl runs: one project per kernel.
/base_proj/
/stereo_proj/
/logs/
dfx_runtime.txt
*.log

# What the Vitis GUI produces, if you open the lab there.
/hls_component/
/_ide/
.vitisWorkspace.json

# waveflow's record of each build step run.
/.waveflow/
